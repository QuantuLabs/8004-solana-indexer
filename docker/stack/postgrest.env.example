# ============================================================
# Optional PostgREST Sidecar (Local PostgreSQL)
# ============================================================
#
# Use with docker/stack/indexer-stack.postgrest.yml:
# docker compose --env-file .env --env-file .env.postgrest \
#   -f docker/stack/indexer-stack.yml \
#   -f docker/stack/indexer-stack.postgrest.yml \
#   --profile postgrest up -d

# Indexer REST proxy wiring (alias env supported by indexer)
POSTGREST_URL=http://postgrest:3000
# JWT signed with PGRST_JWT_SECRET and containing role = PGRST_DB_ANON_ROLE; regenerate per deploy.
POSTGREST_TOKEN=replace-with-deploy-specific-jwt-token
# Local PostgreSQL sidecars typically disable TLS verification on the direct pg DSN.
SUPABASE_SSL_VERIFY=false

# PostgREST container
POSTGREST_IMAGE=postgrest/postgrest:v12.2.8
POSTGREST_PORT=3002

# PostgreSQL DSN (from PostgREST container perspective)
# Docker Desktop (macOS/Windows): host.docker.internal points to host
# Use an authenticator role that can only SET ROLE to PGRST_DB_ANON_ROLE.
PGRST_DB_URI=postgres://authenticator:replace-with-password@host.docker.internal:5432/indexer

# PostgREST configuration
PGRST_DB_SCHEMAS=public
PGRST_DB_EXTRA_SEARCH_PATH=public
PGRST_DB_ANON_ROLE=anon
# Use a 32+ byte random value.
PGRST_JWT_SECRET=replace-with-32-plus-byte-random-secret
PGRST_LOG_LEVEL=info
